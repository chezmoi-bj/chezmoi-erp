# ==============================================================================
# CHEZMOI ERP IMMOBILIER BÉNIN - CONFIGURATION SERVEUR HOSTINGER CLOUD (SANS VPS)
# ==============================================================================

# Port de l'application (Injecté automatiquement par Hostinger Node.js Selector, ou 3000 par défaut)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# BASE DE DONNÉES MYSQL / MARIADB HOSTINGER
# Retrouvez ces identifiants dans votre hPanel Hostinger > Bases de données MySQL
# ------------------------------------------------------------------------------
# Sur Hostinger Cloud partagé, l'hôte MySQL est 'localhost' ou '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306

# Nom d'utilisateur MySQL créé dans hPanel (Format typique Hostinger : u123456789_user)
DB_USER=u123456789_chezmoi

# Mot de passe sécurisé défini lors de la création de la base MySQL sur Hostinger
DB_PASSWORD=VotreMotDePasseHostinger2026!

# Nom de la base de données MySQL (Format typique Hostinger : u123456789_chezmoi_db)
DB_NAME=u123456789_chezmoi_db

# ------------------------------------------------------------------------------
# SÉCURITÉ & TOKENS JWT
# ------------------------------------------------------------------------------
JWT_SECRET=chezmoi_secret_jwt_key_super_admin_2026_benin_cotonou

# ------------------------------------------------------------------------------
# INTÉGRATIONS CLOUD & IA (OPTIONNEL)
# ------------------------------------------------------------------------------
# Clé API Google Gemini (pour description d'annonces et audit cadastre)
GEMINI_API_KEY=votre_cle_gemini_api_ici

# Clé API Anthropic Claude (pour conformité légale des titres fonciers Bénin)
ANTHROPIC_API_KEY=votre_cle_claude_ici

# URL publique de l'application (Ex: https://chezmoi.bj ou https://erp.votredomaine.com)
APP_URL=https://chezmoi.bj
